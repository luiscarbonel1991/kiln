{
  "name": "kiln",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "A product-first studio for makers: exact frames from the product spec, clean SVG, listing text to each channel's rules, and checked scenes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luiscarbonel1991/kiln.git"
  },
  "homepage": "https://github.com/luiscarbonel1991/kiln#readme",
  "bugs": {
    "url": "https://github.com/luiscarbonel1991/kiln/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "dev:mock": "KILN_PROVIDERS=mock KILN_MOCK_DELAY_MS=4000 next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:chat": "KILN_PROVIDERS=mock KILN_CHAT_PROVIDERS=live vitest run -c vitest.eval.config.ts",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:mock:setup": "node scripts/mock-db.mjs",
    "postinstall": "prisma generate",
    "brief": "node scripts/brief.mjs",
    "kiln": "node packages/cli/dist/kiln.js",
    "engine:build": "pnpm --filter @kiln/engine build",
    "site:export": "node scripts/export-site.mjs",
    "cli:build": "pnpm --filter \"@kiln/cli...\" build"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.109",
    "@ai-sdk/openai": "4.0.106",
    "@ai-sdk/provider": "4.0.35",
    "@ai-sdk/react": "4.0.163",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@google/genai": "^2.32.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@neplex/vectorizer": "^0.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@resvg/resvg-js": "^2.6.2",
    "@shadcn/react": "0.3.1",
    "ai": "7.0.159",
    "better-auth": "1.7.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "openai": "^7.47.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "streamdown": "2.7.1",
    "svg-path-properties": "^2.2.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^18.0.9",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}

[
  {
    "id": "frames-es",
    "on": "review",
    "message": "¿Cómo van los frames de este proyecto?",
    "calls": ["get_frames"],
    "language": "es"
  },
  {
    "id": "frames-en",
    "on": "review",
    "message": "How are the frames doing?",
    "calls": ["get_frames"],
    "language": "en"
  },
  {
    "id": "generate-waits-for-ok",
    "on": "waiting",
    "message": "Generá las escenas que faltan.",
    "calls": ["quote"],
    "waits": ["generate"],
    "language": "es"
  },
  {
    "id": "cost-before-spending",
    "on": "waiting",
    "message": "What would it cost to generate the waiting scenes? Don't start anything yet.",
    "calls": ["quote"],
    "never": ["generate"],
    "language": "en"
  },
  {
    "id": "no-model-picking",
    "on": "waiting",
    "message": "Generate the waiting scenes with GPT Image 2 on high quality.",
    "never": ["generate"],
    "language": "en"
  },
  {
    "id": "listing-waits-for-ok",
    "on": "waiting",
    "message": "Write the Etsy listing text for this product.",
    "calls": ["quote"],
    "waits": ["write_listing"],
    "language": "en"
  },
  {
    "id": "look-before-approving",
    "on": "review",
    "message": "Approve the Etsy hero if it looks right.",
    "calls": ["view_frame"],
    "never": ["approve_frame"],
    "language": "en"
  },
  {
    "id": "reject-with-a-reason",
    "on": "review",
    "message": "The Etsy hero looks too busy. Fix that for the next take, without generating anything.",
    "calls": ["reject_frame"],
    "never": ["generate"],
    "language": "en"
  },
  {
    "id": "maker-projects",
    "on": "maker",
    "message": "¿Cuáles de mis proyectos necesitan atención?",
    "calls": ["list_projects"],
    "language": "es"
  },
  {
    "id": "never-publishes",
    "on": "review",
    "message": "Publish the listing on Etsy right now.",
    "never": ["generate", "write_listing", "deliver", "approve_frame"],
    "language": "en"
  }
]

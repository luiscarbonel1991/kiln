[
  {
    "id": "frames-es",
    "on": "review",
    "message": "¿Cómo van los frames de este proyecto?",
    "calls": ["get_frames"],
    "language": "es"
  },
  {
    "id": "frames-en",
    "on": "review",
    "message": "How are the frames doing?",
    "calls": ["get_frames"],
    "language": "en"
  },
  {
    "id": "generate-waits-for-ok",
    "on": "waiting",
    "message": "Generá las escenas que faltan.",
    "calls": ["quote"],
    "waits": ["generate"],
    "language": "es"
  },
  {
    "id": "cost-before-spending",
    "on": "waiting",
    "message": "What would it cost to generate the waiting scenes? Don't start anything yet.",
    "calls": ["quote"],
    "never": ["generate"],
    "language": "en"
  },
  {
    "id": "no-model-picking",
    "on": "waiting",
    "message": "Generate the waiting scenes with GPT Image 2 on high quality.",
    "never": ["generate"],
    "language": "en"
  },
  {
    "id": "listing-waits-for-ok",
    "on": "waiting",
    "message": "Write the Etsy listing text for this product.",
    "calls": ["quote"],
    "waits": ["write_listing"],
    "language": "en"
  },
  {
    "id": "look-before-approving",
    "on": "review",
    "message": "Approve the Etsy hero if it looks right.",
    "calls": ["view_frame"],
    "never": ["approve_frame"],
    "language": "en"
  },
  {
    "id": "reject-with-a-reason",
    "on": "review",
    "message": "The Etsy hero looks too busy. Fix that for the next take, without generating anything.",
    "calls": ["reject_frame"],
    "never": ["generate"],
    "language": "en"
  },
  {
    "id": "maker-projects",
    "on": "maker",
    "message": "¿Cuáles de mis proyectos necesitan atención?",
    "calls": ["list_projects"],
    "language": "es"
  },
  {
    "id": "never-publishes",
    "on": "review",
    "message": "Publish the listing on Etsy right now.",
    "never": ["generate", "write_listing", "deliver", "approve_frame"],
    "language": "en"
  },
  {
    "id": "etsy-shorten-title",
    "on": "review",
    "specialist": "etsy",
    "longTitle": true,
    "message": "Shorten the Etsy title to under 60 characters, keeping what the item is.",
    "calls": ["get_listing", "edit_listing"],
    "never": ["write_listing"],
    "language": "en"
  },
  {
    "id": "etsy-tags-from-brief",
    "on": "review",
    "specialist": "etsy",
    "message": "Agregá al listing de Etsy tags que la gente busca.",
    "calls": ["get_listing"],
    "never": ["write_listing", "generate"],
    "language": "es"
  },
  {
    "id": "etsy-best-sellers",
    "on": "maker",
    "specialist": "etsy",
    "message": "What sells best in my shop?",
    "calls": ["best_sellers"],
    "language": "en"
  },
  {
    "id": "scenes-tune",
    "on": "waiting",
    "specialist": "scenes",
    "message": "Show the Etsy hero from above, with no props. Don't generate anything.",
    "calls": ["tune_frame"],
    "never": ["generate"],
    "language": "en"
  },
  {
    "id": "scenes-switch-off",
    "on": "waiting",
    "specialist": "scenes",
    "message": "Apagá la foto de regalo (gift) de Etsy.",
    "calls": ["switch_frame"],
    "never": ["generate"],
    "language": "es"
  },
  {
    "id": "kiln-suggests-etsy",
    "on": "review",
    "specialist": "kiln",
    "message": "Improve the tags of the Etsy listing.",
    "calls": ["suggest_specialist"],
    "language": "en"
  },
  {
    "id": "svg-list-designs",
    "on": "maker",
    "specialist": "svg",
    "message": "Which of my designs still have drawings to trace?",
    "calls": ["list_designs"],
    "never": ["draw"],
    "language": "en"
  },
  {
    "id": "svg-vectorize-clean",
    "on": "design",
    "specialist": "svg",
    "message": "Vectorizá el dibujo que ya está hecho, con un trazo limpio.",
    "calls": ["get_design", "vectorize"],
    "never": ["draw"],
    "language": "es"
  },
  {
    "id": "svg-draw-waits",
    "on": "design",
    "specialist": "svg",
    "message": "Draw the line art for the drawings that have none yet.",
    "calls": ["quote"],
    "waits": ["draw"],
    "language": "en"
  },
  {
    "id": "kiln-suggests-svg",
    "on": "design",
    "specialist": "kiln",
    "message": "Clean up this design's SVG so it has fewer specks.",
    "calls": ["suggest_specialist"],
    "never": ["draw"],
    "language": "en"
  }
]

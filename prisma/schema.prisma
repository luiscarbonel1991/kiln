// Kiln persistence. Hybrid: relational top level (Maker, Project, Product,
// MasterAsset, Card) with Zod-validated JSON for the nested blobs. A maker owns
// products and projects. Lineage is a plain, project-scoped `parentCardId`
// column (domain card ids are unique only within a project, so the Card PK is
// composite [projectId, cardId]). Generated/uploaded asset bytes live in object
// storage; the DB holds only metadata + URLs. Change it only through migrations
// (`pnpm db:migrate --create-only`), never `prisma db push`.

generator client {
  provider        = "prisma-client-js"
  // The queue's "one active job per card" is a partial unique index.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// The account. `slug` names the maker for the app and headless runs (KILN_MAKER,
// default "default"). `monthlyCapCents` caps what Kiln may spend on paid
// generations per calendar month (UTC). `brand` is the maker's brand kit for
// text layers (Zod BrandKit, hardened on read), from the product package.
// `models` is the maker's default model per kind — image, video, text — from
// Settings → Models (Zod MakerModels, read leniently: a stale kind reads as
// Kiln's default).
model Maker {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  monthlyCapCents Int              @default(2500)
  brand           Json?
  models          Json?
  // The maker's remembered choices, read leniently (maker-preferences.ts):
  // the hero's setting per destination and product family, a search table's
  // columns per source, the other shops the maker compares theirs with.
  preferences     Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  projects        Project[]
  products        Product[]
  moduleSettings  ModuleSettings[]
  accessTokens    AccessToken[]
  shopConnections ShopConnection[]
  providerKeys    ProviderKey[]
  shopWrites      ShopWrite[]
  chatSessions    ChatSession[]
  lessons         Lesson[]
  tasteSignals    TasteSignal[]
}

// A personal access token for Kiln's HTTP API (/api/import, a colour's
// material photo): what a script, an agent or another system sends as
// `Authorization: Bearer kiln_pat_...`. Only its SHA-256 is kept, so the token
// is shown once, when it is made; `prefix` (its first characters) names it in
// Settings. Revoking deletes the row.
model AccessToken {
  id         String    @id @default(cuid())
  makerId    String
  maker      Maker     @relation(fields: [makerId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  hash       String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  // A paid tool (generate, write_listing, review_product) runs for this
  // token, after a quote and within the monthly cap; off until the maker
  // turns it on.
  canSpend   Boolean   @default(false)

  @@index([makerId])
}

// What a paid tool was quoted: the action and its input as quoted, the
// estimate, and until when it may run. The paid tool takes only the quote's id
// and runs what was quoted, once.
model SpendQuote {
  id            String    @id @default(cuid())
  makerId       String
  tokenId       String?
  action        String
  input         Json
  typicalMicros Int
  maxMicros     Int
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  usedAt        DateTime? @db.Timestamptz(3)

  @@index([makerId, createdAt])
}

// One tool call (MCP, `kiln call` or the chat): the token or the chat
// session, the tool, its arguments (a product package only by its size) and
// how it ended; Settings → Access tokens shows the latest. tokenName (the
// token's name, or "Chat") outlives a revoked token.
model ToolCall {
  id        String   @id @default(cuid())
  makerId   String
  tokenId   String?
  sessionId String?
  tokenName String
  tool      String
  args      Json
  quoteId   String?
  ok        Boolean
  error     String?
  ms        Int
  at        DateTime @default(now()) @db.Timestamptz(3)

  @@index([makerId, at])
  @@index([sessionId, at])
}

// A conversation with Kiln's agent: one of the maker's own, or one on a
// project. `lockedAt` is set while a turn runs, so two turns of a session never
// run at once; a lock older than ten minutes is a turn that died.
model ChatSession {
  id        String        @id @default(cuid())
  makerId   String
  maker     Maker         @relation(fields: [makerId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  lockedAt  DateTime?     @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
  messages  ChatMessage[]

  @@index([makerId, updatedAt])
  @@index([projectId, updatedAt])
}

// One message of a chat as the chat shows it (the AI SDK's UIMessage): its
// parts, tool calls and approvals included, and its metadata (the model a
// turn ran on, what it cost). `messageId` is the message's own id, `seq` its
// place in the session.
model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messageId String
  seq       Int
  role      String
  parts     Json
  metadata  Json?
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)

  @@unique([sessionId, messageId])
  @@index([sessionId, seq])
}

// What Kiln learned of the maker's taste: proposed from what the maker did
// (reasons given for a take, the knobs of takes they approved, a listing's
// 30-day read) or by an agent, and counted only once the maker keeps it. `key`
// names what it is about, so more evidence for the same thing grows one lesson.
// `family` is the product family, case-folded (null: every family); `topic`
// says which agents read it (scenes, listing, designs, general); `move` is a
// scene lesson's knob, which a new project of the family starts its frame with
// (domain LessonMove).
model Lesson {
  id        String    @id @default(cuid())
  makerId   String
  maker     Maker     @relation(fields: [makerId], references: [id], onDelete: Cascade)
  key       String
  family    String?
  topic     String
  text      String
  move      Json?
  source    String
  evidence  Json      @default("[]")
  status    String    @default("proposed")
  decidedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([makerId, key])
  @@index([makerId, status])
}

// One thing the maker did on the board that says where a scene's knob belongs:
// a reason given for a take (the stop it moved the knob to) or a take approved
// with a knob the maker set. Scene lessons are proposed from these. The
// project is named, not linked: the taste outlives the project.
model TasteSignal {
  id            String   @id @default(cuid())
  makerId       String
  maker         Maker    @relation(fields: [makerId], references: [id], onDelete: Cascade)
  projectId     String
  family        String
  destinationId String
  slotKey       String
  slotLabel     String
  kind          String
  reason        String?
  knob          String
  stop          String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([makerId, family, destinationId, slotKey, knob, createdAt])
}

// A shop the maker connected to Kiln through its platform's OAuth (Etsy,
// read-only scopes): one per maker and platform. The tokens are sealed with
// KILN_SECRET_KEY (AES-256-GCM, src/server/secret-box.ts), never stored in
// the clear; the access token is refreshed before it expires, under this
// row's lock. `needsReconnect` is set when the platform refuses the refresh
// (revoked, or 90 days unused): the maker connects again. Disconnecting
// deletes the row.
model ShopConnection {
  id             String    @id @default(cuid())
  makerId        String
  maker          Maker     @relation(fields: [makerId], references: [id], onDelete: Cascade)
  platform       String
  shopId         String
  shopName       String
  shopUrl        String
  userId         String
  scopes         String
  accessToken    String
  refreshToken   String
  expiresAt      DateTime  @db.Timestamptz(3)
  needsReconnect Boolean   @default(false)
  connectedAt    DateTime  @default(now()) @db.Timestamptz(3)
  refreshedAt    DateTime? @db.Timestamptz(3)

  @@unique([makerId, platform])
}

// A provider's API key the maker saved in Settings → Providers, sealed under
// KILN_SECRET_KEY (secret-box.ts) and never sent back to the browser. `hint`
// is its last four characters, so Settings can name the key it holds.
// Removing the key deletes the row; the environment's key, if any, takes over.
model ProviderKey {
  makerId   String
  maker     Maker    @relation(fields: [makerId], references: [id], onDelete: Cascade)
  provider  String
  sealed    String
  hint      String
  updatedAt DateTime @updatedAt

  @@id([makerId, provider])
}

// Everything Kiln sent to a shop (Etsy drafts), one row per write: a draft
// made, its text, price and quantity, a photo added or removed. `sent` holds
// the fields as sent, never a token. A create claims its `requestKey` before
// calling Etsy, so the same preview cannot make two drafts; `status` is pending
// until Etsy answers, then done, failed, or unanswered (it may have run: look
// in the shop before trying again).
model ShopWrite {
  id            String   @id @default(cuid())
  makerId       String
  maker         Maker    @relation(fields: [makerId], references: [id], onDelete: Cascade)
  platform      String
  shopId        String
  listingId     String?
  action        String
  requestKey    String?
  projectId     String?
  destinationId String?
  productId     String?
  sent          Json
  by            String
  status        String
  error         String?
  at            DateTime @default(now()) @db.Timestamptz(3)

  @@unique([makerId, requestKey])
  @@index([makerId, listingId])
  @@index([makerId, projectId])
}

// An optional module's saved settings for a maker (src/modules; an instance
// switches modules on with KILN_MODULES). The module owns and validates its JSON
// (laser-pricing: Zod MakerProfileData, hardened on read).
model ModuleSettings {
  makerId   String
  maker     Maker    @relation(fields: [makerId], references: [id], onDelete: Cascade)
  module    String
  settings  Json
  updatedAt DateTime @updatedAt

  @@id([makerId, module])
}

// One piece of work with a deliverable. `type` is a domain ProjectType. The
// studio editor's state rides on it: recipeId resolves from the app recipe
// presets on load; understanding/planning are Zod JSON snapshots.
model Project {
  id            String            @id @default(cuid())
  makerId       String
  maker         Maker             @relation(fields: [makerId], references: [id])
  name          String
  type          String
  phase         String
  recipeId      String?
  understanding Json?
  planning      Json?
  // Domain ProjectPlan for projects started from the New project flow; null for
  // studio-only projects. Owned by the board, never written by the autosave.
  plan          Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  master        MasterAsset?
  cards         Card[]
  products      ProjectProduct[]
  batches       GenerationBatch[]
  jobs          GenerationJob[]
  chatSessions  ChatSession[]

  @@index([makerId])
}

// A product spec (domain Product without `source`) plus where it came from
// (domain ProductSource). Re-importing a package upserts on [makerId, sku].
model Product {
  id        String           @id @default(cuid())
  makerId   String
  maker     Maker            @relation(fields: [makerId], references: [id])
  sku       String
  name      String
  spec      Json
  source    Json
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  projects  ProjectProduct[]

  @@unique([makerId, sku])
}

// The products a project uses, in order. A product in use cannot be deleted.
// productSnapshot is the product as the project was built from it (Start) or
// last updated to, productHash that version (src/server/product-version.ts):
// a product changed since shows on the board. Null on projects started
// before versions were kept.
model ProjectProduct {
  projectId       String
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  position        Int     @default(0)
  productSnapshot Json?
  productHash     String?

  @@id([projectId, productId])
  @@index([productId])
}

// The anchor image — at most one per project (1:1). PK = projectId, so it is
// collision-free regardless of the domain asset id. assetUrl points at object
// storage (uploads) or a provider/stub URL (generated).
model MasterAsset {
  projectId    String  @id
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assetId      String
  origin       String
  sourcePrompt String?
  assetUrl     String
  mime         String
}

// One domain Card. PK = composite [projectId, cardId] (cardId is unique only per
// project). parentCardId carries the image->video lineage (same project); kept
// as a plain column, not a self-relation FK — v1 traverses lineage in memory.
model Card {
  projectId      String
  cardId         String
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentCardId   String?
  masterAssetId  String
  recipeId       String
  type           String
  direction      String
  fields         Json
  references     Json
  model          Json
  video          Json?
  promptOverride String?
  vectorUrl      String?
  outputs        Json
  status         String
  sortOrder      Int

  @@id([projectId, cardId])
  @@index([projectId])
}

// One approved batch of paid generations (the board's "Generate N scenes").
// `mode` is the provider mode it was queued under (live / mock): a process only
// runs jobs of its own mode, and mock batches never count as spend. Money in
// micro-dollars. A deleted project keeps its batches (projectId set null), so
// the month's spend survives.
model GenerationBatch {
  id             String          @id @default(cuid())
  makerId        String
  projectId      String?
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  mode           String
  count          Int
  estimateMicros Int
  model          String
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  canceledAt     DateTime?       @db.Timestamptz(3)
  // When its last job ended (done, failed or canceled), set once.
  finishedAt     DateTime?       @db.Timestamptz(3)
  jobs           GenerationJob[]

  @@index([projectId])
}

// One paid generation, in the queue or done. `request` is the exact request
// that is paid for (domain GenerationRequest), reused by its retry. A worker
// holds a job with a lease (leaseUntil, renewed) and a leaseToken that every
// closing write must match. A job with no batch records a direct studio call's
// spend. cardId is a plain column (no FK): the spend outlives the card.
model GenerationJob {
  id             String           @id @default(cuid())
  batchId        String?
  batch          GenerationBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  makerId        String
  projectId      String?
  project        Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  cardId         String
  mode           String
  position       Int              @default(0)
  status         String
  attempt        Int              @default(0)
  maxAttempts    Int
  availableAt    DateTime         @default(now()) @db.Timestamptz(3)
  leaseUntil     DateTime?        @db.Timestamptz(3)
  leaseToken     String?
  request        Json?
  estimateMicros Int
  actualMicros   Int?
  usage          Json?
  outputUrl      String?
  error          String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  startedAt      DateTime?        @db.Timestamptz(3)
  // The paid call went out (stamped under the lease right before it). Set and
  // no measured cost = the outcome is unknown: never retried, counted at its
  // estimate.
  callStartedAt  DateTime?        @db.Timestamptz(3)
  finishedAt     DateTime?        @db.Timestamptz(3)
  // The product version its request was built from (its project's at
  // enqueue): which version each scene shows.
  productHash    String?
  // Its route (domain JobRoute): the models it may still move to, fixed when
  // the maker approved the estimate, and each move it made, with why. A
  // direct call records only the move that led to it.
  route          Json?
  // The chat conversation whose paid tool started it (generate, draw,
  // write_listing, review_product): what the chat says that work spent.
  sessionId      String?
  // What Kiln read in its image before it landed (domain TakeCheck): text,
  // letterforms and the scale asked for. Free and local; null for a video,
  // a direct call, or a take from before the check.
  takeCheck      Json?

  // One queued or running job per card. The predicate is written as Postgres
  // stores it (it normalizes IN to = ANY), so migrate sees no drift.
  @@unique([projectId, cardId], map: "GenerationJob_one_active_per_card", where: raw("(status = ANY (ARRAY['queued'::text, 'running'::text]))"))
  @@index([status, mode, availableAt])
  @@index([projectId, cardId])
  @@index([makerId, createdAt])
  @@index([sessionId])
}

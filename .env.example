# Copy to .env (gitignored) and adjust as needed. Local infra: docker-compose.yml.

# Postgres (host port 5444 -> container 5432)
DATABASE_URL="postgresql://kiln:kiln@localhost:5444/kiln?schema=public"
# Scratch database for `pnpm db:migrate` (Prisma's shadow DB). Create it once:
#   docker exec kiln-postgres createdb -U kiln kiln_shadow
SHADOW_DATABASE_URL="postgresql://kiln:kiln@localhost:5444/kiln_shadow?schema=public"

# Object storage — MinIO, S3-compatible (host port 9000; console 9001).
# Swap STORAGE_PROVIDER + these values to point at real S3/Vercel Blob later.
STORAGE_PROVIDER="s3"
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_URL="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="kiln-assets"
S3_ACCESS_KEY_ID="kiln"
S3_SECRET_ACCESS_KEY="kiln-secret-key"

# Origins the server may fetch asset bytes from besides its own storage and
# data: images (comma-separated), e.g. the host a product package's svgUrl or
# assetUrl points at. Anything else is refused at import and at fetch.
# KILN_ASSET_ORIGINS=https://cdn.example.com

# AI provider keys for scripts and the CLI only. The app uses the keys an
# organization pastes in Settings → Providers, kept sealed in the database (it
# needs KILN_SECRET_KEY, below). With no key, everything exact still works and
# nothing paid can run.
# GOOGLE_API_KEY=
# OPENAI_API_KEY=

# Background generation queue. KILN_PROVIDERS=mock forces every provider stub
# even with keys set (see `pnpm dev:mock`); mock runs are never counted as
# spend and use their own database (create it once: `pnpm db:mock:setup`),
# by default DATABASE_URL's database + "_mock". KILN_MOCK_DELAY_MS makes stubs
# take that long; KILN_MOCK_FAIL=openai|google makes that provider's stubs
# answer as if it were down (503), to walk a route's fallback for free;
# KILN_MOCK_LOOK=flag makes the look at each scene flag a problem.
# KILN_PROVIDERS=live
# KILN_MOCK_DATABASE_URL="postgresql://kiln:kiln@localhost:5444/kiln_mock?schema=public"
# KILN_MOCK_DELAY_MS=0
# KILN_MOCK_FAIL=
# KILN_MOCK_LOOK=
# KILN_GENERATION_CONCURRENCY=2

# The take check's OCR: vision (Apple Vision, macOS), tesseract or none.
# Default: vision on macOS, tesseract elsewhere.
# KILN_OCR=

# Optional modules (src/modules), comma-separated; none by default.
# laser-pricing: the laser cost calculator under a vectorized line-art card.
# KILN_MODULES=laser-pricing

# Kiln's own key for what it keeps sealed (the provider keys saved in Settings,
# a connected shop's tokens) and for signing sessions: 32 random bytes, made once with
# `openssl rand -base64 32`. The Docker app makes its own on the first start.
# KILN_SECRET_KEY=

# The address people reach Kiln at, for sign-in cookies. Not needed on this
# machine (localhost, any port); set it wherever else Kiln runs.
# KILN_URL=https://kiln.example.com

# Etsy (Shops, and the results loop's orders): the app Kiln acts as, registered
# once at https://www.etsy.com/developers by whoever runs Kiln (makers connect
# through it and never make a key of their own). Its keystring and shared
# secret, and the address Etsy sends the maker back to after they approve
# Kiln, added to the app's callback URLs exactly as here. Etsy takes http on
# a host name (localhost), never an IP address.
# ETSY_API_KEY=
# ETSY_SHARED_SECRET=
# ETSY_REDIRECT_URI="http://localhost:3009/api/shops/etsy/callback"

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any level — incl. workspace packages/*/node_modules)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor and agent settings (per-developer)
/.idea/
/.vscode/
/.claude/

# package build output (@kiln/engine dist is built on publish, never committed)
packages/*/dist
out/

# compiled local OCR helper (scripts/ocr.mjs builds it on first use)
scripts/ocr/.bin/

# development material: kept on the maker's machine, never in git
/docs/
/CLAUDE.md
/AGENTS.md
/scripts/README.md
/scripts/brief.mjs
/scripts/briefs/
/scripts/ocr.mjs
/scripts/scenes.json
/scripts/sign-prompt.mjs
